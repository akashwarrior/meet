NODE_ENV='development'

# BETTER_AUTH
BETTER_AUTH_URL='http://localhost:3000'
BETTER_AUTH_SECRET='replace-with-openssl-rand-base64-32'

# Database URL
DATABASE_URL="postgresql://postgres:password@localhost:5432"

# LiveKit WebSocket URL (Cloud or self-hosted)
NEXT_PUBLIC_LIVEKIT_URL=replace-with-livekit-websocket-url

# API credentials used server-side to mint room tokens
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret